rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['k.duplex16@gmail.com', 'unibite26@gmail.com'];
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // ── products ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category in ['chips','drinks','sweets','meals']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stockQty is number
        && request.resource.data.stockQty >= 0;
      // Admin can update anything (subject to basic type checks).
      // Any signed-in user can ALSO update stockQty/inStock directly —
      // decrements happen when an order is placed (placeOrder transaction),
      // increments happen when a user cancels their own pending order and
      // stock gets restored (cancelActiveOrder transaction). Capped to a
      // ±50-per-write delta so this can't be used to wildly inflate or
      // zero out a product's stock in one call.
      //
      // NOTE: this rule alone can't force the change to be tied to a real
      // order/cancellation — that link is enforced by client transaction
      // logic, not by rules. A malicious client could still call this in
      // isolation to grief a product's stock. Accepted trade-off for
      // staying on the free Spark plan; revisit with a Cloud Function (see
      // chat history) if that becomes a real problem at scale.
      allow update: if isAdmin()
          && (!('price' in request.resource.data) || request.resource.data.price is number)
          && (!('stockQty' in request.resource.data) || request.resource.data.stockQty is number)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty','inStock'])
          && request.resource.data.stockQty is number
          && request.resource.data.stockQty >= 0
          && (request.resource.data.stockQty - resource.data.stockQty) >= -50
          && (request.resource.data.stockQty - resource.data.stockQty) <= 50
          && (!('inStock' in request.resource.data)
              || request.resource.data.inStock == (request.resource.data.stockQty > 0))
        );
      allow delete: if isAdmin();
    }
    // ── orders ───────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Price/name/emoji/imageUrl in each item, and subtotal/total, are NOT
      // validated here against the real product docs — Firestore rules
      // can't cheaply loop + sum a list against other documents. Instead,
      // the client's placeOrder() transaction reads each product doc fresh
      // and computes price/total from THAT data, not from its own cart
      // cache, before this write happens. Rules here just guard shape.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.campus in ['upper','middle']
        && request.resource.data.residence is string
        && request.resource.data.residence.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0;
      // Admin can advance status / set ETA freely. The order's own owner
      // can ALSO update it, but only to cancel — and only while it's still
      // 'pending' (once the admin confirms/starts packing, the owner can no
      // longer back out through this path). Only the 'status' field may
      // change, and it must become exactly 'cancelled'.
      allow update: if isAdmin()
        || (
          isOwner(resource.data.userId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'
        );
      allow delete: if false;
    }
    // ── carts/{uid} ──────────────────────────────────────────
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
