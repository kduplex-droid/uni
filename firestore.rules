rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'k.duplex16@gmail.com';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // ── products ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category in ['chips','drinks','sweets','meals']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stockQty is number
        && request.resource.data.stockQty >= 0;
      // Admin-only now. Stock is decremented server-side by the placeOrder
      // Cloud Function (Admin SDK, bypasses these rules) as part of the
      // order transaction, so there's no need for a client-write branch here
      // anymore — and removing it closes the "decrement without ordering"
      // griefing vector.
      allow update: if isAdmin()
        && (!('price' in request.resource.data) || request.resource.data.price is number)
        && (!('stockQty' in request.resource.data) || request.resource.data.stockQty is number);
      allow delete: if isAdmin();
    }
    // ── orders ───────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Orders are created exclusively by the placeOrder Cloud Function,
      // which runs with Admin SDK privileges and bypasses these rules.
      // No client — not even the order's own user — can create one directly.
      // This is what stops price/total tampering: the function recomputes
      // everything from the live product docs, so nothing the client sends
      // about price ever reaches the order.
      allow create: if false;
      // Only the admin advances status / sets ETA.
      allow update: if isAdmin();
      allow delete: if false;
    }
    // ── carts/{uid} ──────────────────────────────────────────
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
